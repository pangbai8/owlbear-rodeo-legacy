+// The spreadsheet app reads its formula bar visibility from this key when it
+// starts; View > Formula Bar writes it (same origin as this page).
+const FORMULA_BAR_KEY = 'sse-hidden-formula';
+// The user's own setting, parked while chrome=minimal forces the bar hidden.
+const FORMULA_BAR_PARKED_KEY = 'embed-minimal-chrome:sse-hidden-formula';
+const UNSET = '';
+
+/**
+ * Hide the formula bar for chrome=minimal without losing the user's choice:
+ * the first minimal boot parks the current value, later minimal boots leave
+ * it parked, and the next full boot puts it back.
+ */
+function applyFormulaBarForChrome(minimal: boolean): void {
+  try {
+    const parked = localStorage.getItem(FORMULA_BAR_PARKED_KEY);
+    if (minimal) {
+      if (parked === null) {
+        localStorage.setItem(FORMULA_BAR_PARKED_KEY, localStorage.getItem(FORMULA_BAR_KEY) ?? UNSET);
+      }
+      localStorage.setItem(FORMULA_BAR_KEY, '1');
+    } else if (parked !== null) {
+      if (parked === UNSET) localStorage.removeItem(FORMULA_BAR_KEY);
+      else localStorage.setItem(FORMULA_BAR_KEY, parked);
+      localStorage.removeItem(FORMULA_BAR_PARKED_KEY);
+    }
+  } catch {
+    // Storage unavailable: the formula bar keeps its default
+  }
+}
