+
+/**
+ * `chrome=minimal` on the editor URL: start without toolbar, side menus and
+ * header so a host page can show just the document. The vendor applies layout
+ * customization once at boot, so a host toggles it by reloading the editor.
+ */
+export function isMinimalChrome(): boolean {
+  if (typeof window === 'undefined') return false;
+  return new URLSearchParams(window.location.search).get('chrome') === 'minimal';
+}
