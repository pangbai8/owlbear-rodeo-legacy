{
  "name": "discord-bridge",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Must be the same site as the VTT (vtt.pangbai.de) so the login cookie
  // reaches the page inside the Owlbear iframe.
  "routes": [{ "pattern": "discord.pangbai.de", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "vars": {
    // Fill these in (they are not secret). CHANNEL_IDS: comma-separated.
    "DISCORD_CLIENT_ID": "",
    "GUILD_ID": "",
    "CHANNEL_IDS": "",
    // Optional: only members with one of these role ids may use the chat
    "ALLOWED_ROLE_IDS": "",
    // Pages allowed to embed the chat in an iframe
    "FRAME_ANCESTORS": "https://vtt.pangbai.de",
  },
  // Secrets: npx wrangler secret put DISCORD_BOT_TOKEN --config wrangler.deploy.jsonc
  // (also DISCORD_CLIENT_SECRET and SESSION_SECRET)
}
